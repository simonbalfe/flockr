{
  "name": "@flockr/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dev": "./src/dev.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "openapi": "bun scripts/openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:backup": "bun scripts/backup.ts",
    "db:restore": "bun scripts/restore.ts",
    "seed": "bun scripts/seed.ts",
    "test": "bun test --timeout 20000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "worker:dev": "wrangler dev --port 8787",
    "worker:smoke": "bun scripts/worker-smoke.ts"
  },
  "dependencies": {
    "@chat-adapter/slack": "4.45.0",
    "@earendil-works/chord": "1.5.1",
    "@earendil-works/pi-durable": "1.5.1",
    "@flockr/contracts": "workspace:*",
    "@flockr/runner": "workspace:*",
    "@hono/swagger-ui": "0.6.2",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.20",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@hono/vite-dev-server": "0.26.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.160.0"
  }
}
