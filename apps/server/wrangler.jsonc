{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flockr",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "BOARD_ROOM", "class_name": "BoardRoom" },
      { "name": "CLOUD_AGENT", "class_name": "CloudAgent" },
      { "name": "SANDBOX", "class_name": "SandboxBox" },
      { "name": "SANDBOX_INDEX", "class_name": "SandboxIndex" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }, { "tag": "v2", "new_sqlite_classes": ["CloudAgent"] }, { "tag": "v3", "new_sqlite_classes": ["SandboxBox", "SandboxIndex"] }],
  "containers": [{ "class_name": "SandboxBox", "scheduling_policy": "durable_object", "images": { "box": { "dockerfile": "../../packages/sandbox/box/Dockerfile" } } }],
  "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "FLOCKR_EMAIL_FROM": "flockr@example.com" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://flockr:flockr@127.0.0.1:5432/flockr"
    }
  ],
  "env": {
    "production": {
      "name": "flockr",
      "routes": [{ "pattern": "flockr.simonbalfe.com", "custom_domain": true }],
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/mcp", "/ws", "/.well-known/*"]
      },
      "durable_objects": { "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }, { "name": "CLOUD_AGENT", "class_name": "CloudAgent" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }, { "tag": "v2", "new_sqlite_classes": ["CloudAgent"] }],
      "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "FLOCKR_AUTH": "on",
        "FLOCKR_URL": "https://flockr.simonbalfe.com",
        "FLOCKR_EMAIL": "cloudflare",
        "FLOCKR_EMAIL_FROM": "flockr@simonbalfe.com",
        "FLOCKR_S3_ENDPOINT": "https://ac4542261404facc325b2e023535b26a.r2.cloudflarestorage.com",
        "FLOCKR_S3_BUCKET": "flockr"
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "8941dae444494989a7ee586703cab27b" }]
    }
  }
}
